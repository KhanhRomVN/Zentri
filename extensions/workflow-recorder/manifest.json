{
  "manifest_version": 3,
  "name": "Zentri Workflow Recorder",
  "version": "1.0.0",
  "description": "Record web interactions for Zentri workflows",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_title": "Toggle Recording"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
